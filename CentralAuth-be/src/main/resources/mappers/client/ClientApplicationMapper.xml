<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.centralauth.client.ClientApplicationMapper">

	<resultMap id="ClientApplicationResultMap" type="com.centralauth.client.ClientApplication">
		<constructor>
			<arg column="client_id" javaType="string"/>
			<arg column="client_name" javaType="string"/>
			<arg column="active" javaType="boolean"/>
			<arg column="created_at" javaType="java.time.Instant"/>
			<arg column="updated_at" javaType="java.time.Instant"/>
			<arg column="client_id" javaType="java.util.List" select="findRedirectUrisByClientId"/>
			<arg column="client_id" javaType="java.util.List" select="findAllowedOriginsByClientId"/>
		</constructor>
	</resultMap>

	<insert id="insert" parameterType="com.centralauth.client.ClientApplication">
		insert into clients (client_id, client_name, active)
		values (#{clientId}, #{clientName}, #{active})
	</insert>

	<select id="findByClientId" resultMap="ClientApplicationResultMap">
		select client_id,
		       client_name,
		       active,
		       created_at,
		       updated_at
		from clients
		where client_id = #{clientId}
	</select>

	<select id="findAll" resultMap="ClientApplicationResultMap">
		select client_id,
		       client_name,
		       active,
		       created_at,
		       updated_at
		from clients
		order by created_at desc, client_id asc
	</select>

	<select id="findRedirectUrisByClientId" resultType="string">
		select redirect_uri
		from client_redirect_uris
		where client_id = #{clientId}
		order by redirect_uri asc
	</select>

	<select id="findAllowedOriginsByClientId" resultType="string">
		select origin
		from client_allowed_origins
		where client_id = #{clientId}
		order by origin asc
	</select>

	<insert id="insertRedirectUri">
		insert into client_redirect_uris (client_id, redirect_uri)
		values (#{clientId}, #{redirectUri})
	</insert>

	<delete id="deleteRedirectUris">
		delete from client_redirect_uris
		where client_id = #{clientId}
	</delete>

	<insert id="insertAllowedOrigin">
		insert into client_allowed_origins (client_id, origin)
		values (#{clientId}, #{origin})
	</insert>

	<delete id="deleteAllowedOrigins">
		delete from client_allowed_origins
		where client_id = #{clientId}
	</delete>

	<update id="updateClient">
		update clients
		set client_name = #{clientName},
		    active = #{active},
		    updated_at = current_timestamp
		where client_id = #{clientId}
	</update>

	<update id="updateActive">
		update clients
		set active = #{active},
		    updated_at = current_timestamp
		where client_id = #{clientId}
	</update>
</mapper>
